# VitalAgent — Environment Variables
# Copy this file to .env and fill in your values.

# Global LLM fallback (OpenAI-compatible API)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048

# Reactive answer model
LLM_AGENT_MODEL=deepseek-v4-flash
LLM_AGENT_TEMPERATURE=0
LLM_AGENT_MAX_TOKENS=2048
LLM_AGENT_DISABLE_REASONING=true

# Reactive planner model
LLM_PLANNER_MODEL=deepseek-v4-flash
LLM_PLANNER_TEMPERATURE=0
LLM_PLANNER_MAX_TOKENS=8192
LLM_PLANNER_DISABLE_REASONING=false

# Proactive LLM judge (not the deterministic evaluate_proactive_rules tool)
LLM_PROACTIVE_MODEL=deepseek-v4-flash
LLM_PROACTIVE_TEMPERATURE=0
LLM_PROACTIVE_MAX_TOKENS=2048
LLM_PROACTIVE_DISABLE_REASONING=false
LLM_PROACTIVE_ENABLED=true

# LLM transport and retry behavior (OpenAI SDK defaults + project retry layer)
LLM_CONNECT_TIMEOUT_S=5
LLM_READ_TIMEOUT_S=600
LLM_WRITE_TIMEOUT_S=600
LLM_POOL_TIMEOUT_S=600
LLM_SDK_MAX_RETRIES=2
LLM_TRANSIENT_RETRY_ATTEMPTS=3
LLM_TRANSIENT_RETRY_BACKOFF_S=1,2,4

# Canonical local dataset/artifact paths
DATASET_ICENTIA11K_ROOT=./dataset/icentia11k_subset/1.0
DATASET_AFPPGECG_ROOT=./dataset/zenodo_af_monitoring_v11242869/raw
DATASET_PPG_DALIA_ROOT=./dataset/ppg_dalia/PPG_FieldStudy
DATASET_WESAD_ROOT=./dataset/WESAD

# Released VitalBench benchmark (what the evaluator reads)
DATASET_VITALBENCH_ROOT=./dataset/vitalbench/final

# Reactive pipeline behavior
PIPELINE_MAX_RETRIES=1
PIPELINE_VERBOSE=true
PIPELINE_DISABLE_VALIDATION=false

# Enable/disable the ECGFounder-backed diagnosis tool
ENABLE_ECG_DIAGNOSIS=true


